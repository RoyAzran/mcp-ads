{
  "name": "@marketingmcp/cli",
  "version": "0.1.0",
  "description": "Local stdio MCP server for MCP Ads (open-source) -- Google Ads, Meta Ads, GA4, Search Console and more from any MCP client. Works against the cloud or your own self-hosted server.",
  "license": "MIT",
  "homepage": "https://github.com/RoyAzran/mcp-ads/tree/main/cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/RoyAzran/mcp-ads",
    "directory": "cli"
  },
  "bin": {
    "marketingmcp": "./bin/marketingmcp.js"
  },
  "files": [
    "bin/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=bin/marketingmcp.js --banner:js=\"#!/usr/bin/env node\" && node -e \"require('fs').chmodSync('bin/marketingmcp.js', 0o755)\"",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "claude-ai",
    "anthropic",
    "google-ads",
    "meta-ads",
    "facebook-ads",
    "google-analytics",
    "ga4",
    "search-console",
    "tiktok-ads",
    "linkedin-ads",
    "wordpress",
    "marketing",
    "advertising",
    "martech",
    "ai-agent",
    "llm-tools"
  ]
}
