# MCP Ads — self-hosted configuration.
#
# Copy to .env and fill in what you use. Every platform is optional: the server
# runs with whatever is configured and says clearly what is not connected.
# `python server.py doctor` reports what it can see.

# ------ Google (Ads, GA4, Search Console, Tag Manager, Sheets) ------
# One OAuth app + one refresh token covers all Google services.
# 1. Create an OAuth client (Desktop or Web) in Google Cloud Console.
# 2. Authorize it once for the scopes you need; store the refresh token here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Per-service overrides, if one account should not cover everything:
# GOOGLE_ADS_REFRESH_TOKEN=
# GA4_REFRESH_TOKEN=
# GSC_REFRESH_TOKEN=
# GTM_REFRESH_TOKEN=
# SHEETS_REFRESH_TOKEN=

# Google Ads additionally requires a developer token (apply in the Google Ads
# UI under API Center; Basic access takes a review that can run 1-3 weeks).
GOOGLE_ADS_DEVELOPER_TOKEN=
# Set when you access client accounts through an MCC manager account:
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ------ Meta (Facebook / Instagram ads) ------
# Needs a Meta app; ads_management and ads_read require Meta App Review before
# they work for anyone but the app's own testers/admins.
META_APP_ID=
META_APP_SECRET=
# A long-lived user or system-user access token with the ads scopes:
META_ACCESS_TOKEN=
# Optional: a Page token for organic Page/Instagram publishing:
# META_PAGE_ACCESS_TOKEN=
# Optional default ad account (with or without the act_ prefix):
# META_AD_ACCOUNT_ID=
# Graph API version override:
# META_GRAPH_VERSION=v22.0

# ------ Meta Ad Library (competitor research, official API) ------
# Requires the token holder to have completed Meta's ID verification.
# META_AD_LIBRARY_TOKEN=

# ------ Google Ads Transparency (competitor research, unofficial) ------
# OFF by default. This family calls endpoints the Transparency Center site
# itself uses; Google documents no API for them and they may change or refuse
# without notice. Read the module docstring before enabling.
GOOGLE_ADS_TRANSPARENCY_ENABLED=false

# ------ LinkedIn Ads / TikTok Ads / Snapchat Ads / Microsoft Ads ------
# Each takes that platform's own OAuth credentials. Honest difficulty ranking:
# Snapchat (self-serve) < Microsoft (sandbox token instant) < TikTok (app
# review) < LinkedIn (Marketing Developer Platform approval, often refused).
# SNAPCHAT_ACCESS_TOKEN=
# MICROSOFT_ADS_ACCESS_TOKEN=
MICROSOFT_ADS_DEVELOPER_TOKEN=
# TIKTOK_ADS_ACCESS_TOKEN=
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_API_VERSION=202411

# ------ TikTok organic posting (first-party app) ------
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_ORGANIC_ACCESS_TOKEN=

# ------ WordPress ------
# Site URL + a user's Application Password (Users -> Profile in wp-admin).
WORDPRESS_TOOLS_ENABLED=true
# WORDPRESS_SITE_URL=https://example.com
# WORDPRESS_USERNAME=
# WORDPRESS_APP_PASSWORD=

# ------ Creative generation ------
# Your OpenAI API key, used only by the creative_* image tools.
# OPENAI_API_KEY=

# ------ Server ------
# Encrypts the local credential store ($MCP_ADS_HOME/credentials.json) when
# set. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MCP_ADS_SECRET_KEY=
# Where the credential store and staged media live (default ~/.mcp-ads):
# MCP_ADS_HOME=
# Shared secret for the /api/cli/* routes in HTTP mode. Optional on loopback.
# MCP_ADS_API_KEY=
# Extra hostnames allowed through DNS-rebinding protection (comma-separated):
# ALLOWED_HOSTS=
# Where error messages send you when a platform is not connected:
# MCP_ADS_CONNECT_HINT=

# ------ Media staging (for uploading creatives to Meta) ------
# Meta fetches creatives from a public URL. Either a GCS bucket:
# GCS_MEDIA_BUCKET=
# ...or leave unset and pass local file paths / public URLs to the tools.

# ------ Optional telemetry (yours, off unless both are set) ------
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=
