# MCP Ads — self-hosted configuration.
#
# Copy this file to .env and fill in ONLY the platforms you actually use —
# every section is independent and optional. The server starts fine with
# nothing configured; run `python server.py doctor` any time to see exactly
# what it can and can't see.
#
#   cp .env.example .env
#   python server.py doctor
#
# Never commit .env — it's already in .gitignore.

# =============================================================================
# GOOGLE (Ads, GA4, Search Console, Tag Manager, Sheets)
# =============================================================================
# One OAuth app + one refresh token covers all five services below.
#
# How to get GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET:
#   1. console.cloud.google.com -> create a project (or pick an existing one).
#   2. APIs & Services -> Credentials -> Create Credentials -> OAuth client ID.
#   3. Application type: "Desktop app" (simplest — no redirect URI to manage).
#   4. Copy the Client ID and Client Secret it shows you into the two lines below.
#
# How to get GOOGLE_REFRESH_TOKEN (one-time, in a browser):
#   1. APIs & Services -> OAuth consent screen -> add yourself as a test user
#      if the app is in "Testing" mode (fine for personal use).
#   2. Use Google's OAuth 2.0 Playground (developers.google.com/oauthplayground):
#      gear icon (top right) -> check "Use your own OAuth credentials" -> paste
#      your Client ID/Secret -> in Step 1, pick the scopes you need, e.g.:
#        https://www.googleapis.com/auth/adwords
#        https://www.googleapis.com/auth/analytics.readonly
#        https://www.googleapis.com/auth/webmasters.readonly
#        https://www.googleapis.com/auth/tagmanager.readonly
#        https://www.googleapis.com/auth/spreadsheets
#   3. Authorize APIs -> sign in with the Google account that owns your ad/
#      analytics accounts -> Step 2: "Exchange authorization code for tokens"
#      -> copy the Refresh token value.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Per-service overrides — only needed if one Google login should NOT cover
# everything (e.g. GA4 lives under a different account than Google Ads).
# Get each the same way as above, with only that service's scope selected.
# GOOGLE_ADS_REFRESH_TOKEN=
# GA4_REFRESH_TOKEN=
# GSC_REFRESH_TOKEN=
# GTM_REFRESH_TOKEN=
# SHEETS_REFRESH_TOKEN=

# Google Ads ADDITIONALLY requires a developer token (the refresh token above
# is not enough on its own):
#   1. ads.google.com -> Tools & Settings -> Setup -> API Center.
#   2. Apply for a token. "Test account" access is instant and works against
#      Google Ads test accounts; "Basic" access (real accounts) is a review
#      that Google runs, typically 1-3 weeks.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Default customer id (10 digits, no dashes) so tools don't need it every call:
# GOOGLE_ADS_CUSTOMER_ID=
# Set only if you access client accounts through an MCC manager account:
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Your Search Console property, if you want a default (e.g. https://example.com/):
# GSC_SITE_URL=

# =============================================================================
# META (Facebook / Instagram ads)
# =============================================================================
# How to get META_APP_ID / META_APP_SECRET:
#   1. developers.facebook.com/apps -> Create App -> type "Business".
#   2. App Dashboard -> Settings -> Basic: copy App ID and App Secret.
#
# How to get META_ACCESS_TOKEN (a long-lived token with ads scopes):
#   1. developers.facebook.com/tools/explorer -> select your app.
#   2. "Get Token" -> "Get User Access Token" -> check ads_management,
#      ads_read, business_management (add leads_retrieval, pages_* if you
#      need lead forms or Page posting).
#   3. This gives a short-lived token; exchange it for a long-lived one:
#      developers.facebook.com/tools/debug/accesstoken/ -> paste the token
#      -> "Extend Access Token" (or use a System User token instead, below,
#      which doesn't expire and is the sturdier choice for a long-running
#      server: Business Settings -> Users -> System Users -> Add -> Generate
#      Token with the same scopes).
#   Note: ads_management and ads_read only work for the app's own
#   admins/testers/developers until the app passes Meta App Review — App
#   Dashboard -> App Review -> Permissions and Features.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Optional: a separate Page token for organic Facebook/Instagram publishing
# (Graph API Explorer -> "Get Page Access Token" for the specific Page):
# META_PAGE_ACCESS_TOKEN=
# Optional default ad account (with or without the act_ prefix; find it at
# business.facebook.com/settings/ad-accounts):
# META_AD_ACCOUNT_ID=
# Graph API version override, if you need to pin one:
# META_GRAPH_VERSION=v22.0

# =============================================================================
# META AD LIBRARY (competitor research — official API)
# =============================================================================
# A token from an identity that has completed Meta's ID verification
# (facebook.com/ID). Any access token generated by that verified identity's
# app works — same Graph API Explorer flow as META_ACCESS_TOKEN above.
# META_AD_LIBRARY_TOKEN=

# =============================================================================
# GOOGLE ADS TRANSPARENCY (competitor research — unofficial)
# =============================================================================
# OFF by default. This family calls the endpoints the Ads Transparency Center
# WEBSITE itself uses; Google documents no public API for them, and they may
# change or start refusing without notice. No credential needed — read
# tools/google_ads_transparency.py's docstring before flipping this on.
GOOGLE_ADS_TRANSPARENCY_ENABLED=false

# =============================================================================
# SNAPCHAT ADS  —  easiest of the four OAuth platforms below
# =============================================================================
# How to get SNAPCHAT_CLIENT_ID / SNAPCHAT_CLIENT_SECRET:
#   1. business.snapchat.com -> your Business -> Business Details -> OAuth
#      Apps (or ads.snapchat.com/apps) -> Create App.
#   2. Add http://127.0.0.1:8765/callback as an allowed redirect URI.
#   3. Copy the Client ID and Client Secret.
# Then run:  python server.py auth snapchat_ads
# — it opens the consent page, catches the callback, and stores + auto-
# refreshes the token for you. Nothing else to fill in here.
# SNAPCHAT_CLIENT_ID=
# SNAPCHAT_CLIENT_SECRET=

# =============================================================================
# MICROSOFT ADVERTISING (Bing Ads)
# =============================================================================
# How to get MICROSOFT_ADS_CLIENT_ID / MICROSOFT_ADS_CLIENT_SECRET:
#   1. entra.microsoft.com (Microsoft Entra ID) -> App registrations -> New
#      registration.
#   2. Add http://127.0.0.1:8765/callback as a Web redirect URI.
#   3. Certificates & secrets -> New client secret -> copy the VALUE (not the
#      secret ID) immediately — Azure only shows it once.
#   4. Overview page has the Client ID.
# Then run:  python server.py auth microsoft_ads
#
# ADDITIONALLY requires a developer token:
#   1. ads.microsoft.com -> Tools -> Developer Portal -> Get Developer Token.
#   2. A sandbox token is issued instantly and works against Microsoft's
#      sandbox environment; a production token requires an application that
#      Microsoft reviews.
# MICROSOFT_ADS_CLIENT_ID=
# MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_DEVELOPER_TOKEN=

# =============================================================================
# TIKTOK ADS
# =============================================================================
# How to get TIKTOK_ADS_ACCESS_TOKEN:
#   1. business-api.tiktok.com -> My Apps -> Create an App.
#   2. Requesting Ad Account Management / Ads Management / Reporting scopes
#      requires TikTok's app review (this is the slow part — days to weeks).
#   3. Once approved, TikTok's Marketing API OAuth flow issues a long-lived
#      (effectively non-expiring) token — follow TikTok's own "Authorization"
#      doc under Marketing API -> Get Started, using
#      http://127.0.0.1:8765/callback as the redirect URI.
# TIKTOK_ADS_ACCESS_TOKEN=

# =============================================================================
# LINKEDIN ADS  —  hardest to get; often refused to individuals
# =============================================================================
# How to get LINKEDIN_CLIENT_ID / LINKEDIN_CLIENT_SECRET:
#   1. www.linkedin.com/developers/apps -> Create app.
#   2. Products tab -> request "Advertising API" access.
#   3. This requires LinkedIn Marketing Developer Platform approval — a
#      review LinkedIn runs and commonly declines for individual developers
#      (a registered business/agency has better odds).
#   4. If approved: Auth tab has the Client ID/Secret; add
#      http://127.0.0.1:8765/callback as an authorized redirect URL.
# Then run:  python server.py auth linkedin_ads
# If you never get approved, leave this blank — every other platform in this
# file works independently of it.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202411

# =============================================================================
# TIKTOK ORGANIC POSTING (separate from TikTok Ads — a different app/API)
# =============================================================================
# How to get TIKTOK_CLIENT_KEY / TIKTOK_CLIENT_SECRET:
#   1. developers.tiktok.com/apps -> Create an app.
#   2. Add the "Login Kit" and "Content Posting API" products.
#   3. Add http://127.0.0.1:8765/callback as a redirect URI.
# Then run:  python server.py auth tiktok_organic
# (Access tokens last ~24h; refresh is automatic afterward.)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=

# =============================================================================
# WORDPRESS
# =============================================================================
# How to get WORDPRESS_APP_PASSWORD:
#   1. In wp-admin: Users -> Profile (your own user, or a dedicated one) ->
#      scroll to "Application Passwords" -> enter a name -> Add New
#      Application Password.
#   2. Copy the generated password (shown once, spaces and all — the tools
#      strip them automatically).
WORDPRESS_TOOLS_ENABLED=true
# WORDPRESS_SITE_URL=https://example.com
# WORDPRESS_USERNAME=
# WORDPRESS_APP_PASSWORD=

# =============================================================================
# CREATIVE GENERATION
# =============================================================================
# How to get OPENAI_API_KEY: platform.openai.com/api-keys -> Create new
# secret key. Used only by the creative_* image-generation tools; billed to
# your OpenAI account per image.
# OPENAI_API_KEY=

# =============================================================================
# SERVER
# =============================================================================
# Encrypts $MCP_ADS_HOME/credentials.json (the local store the OAuth helper
# and TikTok-organic refresh write to). Optional — without it that file is
# plaintext with owner-only (0600) permissions, which is no less protected
# than this .env file sitting right next to it. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MCP_ADS_SECRET_KEY=
# Where the credential store and staged media live (default ~/.mcp-ads):
# MCP_ADS_HOME=
# Shared secret for the /api/cli/* routes when running --transport http.
# Optional on loopback; set it if you put this behind a reverse proxy.
# MCP_ADS_API_KEY=
# Extra hostnames allowed through DNS-rebinding protection, comma-separated
# (only needed if you bind something other than 127.0.0.1/localhost):
# ALLOWED_HOSTS=
# Where "not connected" error messages point the user (defaults to
# "your .env file"):
# MCP_ADS_CONNECT_HINT=

# =============================================================================
# MEDIA STAGING (uploading creatives to Meta)
# =============================================================================
# Meta fetches image/video creatives from a public URL. Either point at a GCS
# bucket you own (console.cloud.google.com -> Cloud Storage -> Create bucket;
# the server needs Storage Object Admin on it via Application Default
# Credentials or a service account key), or leave this unset and pass local
# file paths / already-public URLs directly to the tools.
# GCS_MEDIA_BUCKET=

# =============================================================================
# OPTIONAL TELEMETRY (yours — off unless you set BOTH of these)
# =============================================================================
# A PostHog project you own, if you want to see your own usage. Nothing is
# ever sent anywhere unless both variables below are set.
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=
